{
  "name": "code-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "scripts": {
    "dev": "bun run --parallel dev:server dev:css",
    "dev:server": "bun --watch src/index.ts",
    "dev:css": "tailwindcss -i src/routes/web/views/styles.css -o src/routes/web/public/app.css --watch",
    "build": "tailwindcss -i src/routes/web/views/styles.css -o src/routes/web/public/app.css --minify",
    "start": "bun src/index.ts",
    "typecheck": "tsc",
    "test": "bun test",
    "test:container": "docker build -q -f test/container/Dockerfile -t container-test . && docker run --rm --privileged --cgroupns=private -v \"$PWD/src:/usr/src/app/src:ro\" -v \"$PWD/test:/usr/src/app/test:ro\" container-test"
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "@fastify/type-provider-typebox": "^6.3.0",
    "@fastify/view": "^12.0.1",
    "ajv-formats": "^3.0.1",
    "drizzle-orm": "^0.45.4",
    "eta": "^4.6.0",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "typebox": "^1.4.2"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/bun": "^1.4.3",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
