{
  "name": "harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --parallel dev:server dev:css",
    "dev:server": "bun --watch src/index.ts",
    "dev:css": "tailwindcss -i src/routes/web/views/styles.css -o src/routes/web/public/app.css --watch=always",
    "build": "rm -rf dist && bun run build:css && bun run build:server",
    "build:css": "tailwindcss -i src/routes/web/views/styles.css -o src/routes/web/public/app.css --minify",
    "build:server": "bun build src/index.ts --target bun --outdir dist --minify --keep-names --sourcemap=linked --external playwright-core && cp -R src/routes/web/views src/routes/web/public dist/ && mkdir -p dist/node_modules && cp -RL node_modules/playwright-core dist/node_modules/",
    "start": "bun src/index.ts",
    "db:generate": "bun --bun drizzle-kit generate",
    "db:migrate": "bun scripts/migrate.ts",
    "typecheck": "tsc",
    "test": "bun test --isolate",
    "test:container": "docker build -q -f test/container/Dockerfile -t container-test .. && docker run --rm --privileged --cgroupns=private -v \"$PWD/src:/usr/src/app/harness/src:ro\" -v \"$PWD/test:/usr/src/app/harness/test:ro\" -v \"$PWD/drizzle:/usr/src/app/harness/drizzle:ro\" container-test"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/formbody": "^9.0.1",
    "@fastify/multipart": "^10.1.4",
    "@fastify/static": "^10.1.6",
    "@fastify/type-provider-typebox": "^6.3.0",
    "@fastify/view": "^12.0.1",
    "ajv-formats": "^3.0.1",
    "drizzle-orm": "^0.45.4",
    "eta": "^4.6.0",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "playwright-core": "1.64.1",
    "typebox": "^1.4.2",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@tailwindcss/cli": "^4.3.3",
    "@types/bun": "^1.4.3",
    "@types/ioredis-mock": "^8.2.8",
    "@types/pg": "^8.23.1",
    "@types/yauzl": "^3.4.0",
    "drizzle-kit": "^0.31.11",
    "fflate": "^0.8.3",
    "ioredis-mock": "^8.13.1",
    "pino-pretty": "^13.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
