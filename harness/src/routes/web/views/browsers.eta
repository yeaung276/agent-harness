<% layout('./app') %>
<div class="px-8 py-6">
  <h1 class="text-xl font-semibold tracking-tight">Browsers</h1>
  <p class="mt-1 text-sm text-gray-600">Browser sessions opened against workspaces. Everyone sees every session.</p>

  <div class="mt-6 overflow-x-auto rounded-lg border border-gray-200">
    <table class="w-full text-left text-sm">
      <thead class="bg-gray-50 text-xs uppercase tracking-wide text-gray-500">
        <tr>
          <th class="px-4 py-2.5 font-medium">Status</th>
          <th class="px-4 py-2.5 font-medium">URL</th>
          <th class="px-4 py-2.5 font-medium">Recording</th>
          <th class="px-4 py-2.5 font-medium">Last used</th>
          <th class="px-4 py-2.5 font-medium">Created</th>
          <th class="px-4 py-2.5 font-medium">Created by</th>
          <th class="px-4 py-2.5 font-medium">Workspace</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <% if (!it.sessions.length) { %>
        <tr><td colspan="7" class="px-4 py-6 text-center text-gray-500"><%= it.pagination.total ? 'No browser sessions on this page.' : 'No browser sessions yet.' %></td></tr>
        <% } %>
        <% it.sessions.forEach(session => { %>
        <tr>
          <td class="px-4 py-2.5">
            <span class="inline-flex items-center gap-1.5 capitalize">
              <span class="size-2 rounded-full <%= session.status === 'alive' ? 'bg-green-500' : 'bg-gray-400' %>"></span>
              <%= session.status %>
            </span>
          </td>
          <td class="max-w-xs truncate px-4 py-2.5 font-mono text-gray-600"><%= session.url ?? '—' %></td>
          <td class="px-4 py-2.5 text-gray-600"><%= session.record ? 'Yes' : 'No' %></td>
          <td class="px-4 py-2.5 text-gray-600"><%= session.lastUsed %></td>
          <td class="px-4 py-2.5 text-gray-600"><%= session.created %></td>
          <td class="px-4 py-2.5 text-gray-600"><%= session.createdBy %></td>
          <td class="px-4 py-2.5">
            <% if (session.workspaceId) { %>
            <a href="/workspaces/<%= session.workspaceId %>" aria-label="Open workspace" class="text-gray-600 hover:text-gray-900">→</a>
            <% } else { %>
            <span class="text-gray-400">—</span>
            <% } %>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <% if (it.pagination.total) { %>
  <nav class="mt-3 flex items-center justify-between text-sm text-gray-600" aria-label="Pagination">
    <span><%= it.sessions.length ? `${it.pagination.from}–${it.pagination.to} of ${it.pagination.total}` : `${it.pagination.total} in all` %></span>
    <div class="flex gap-2">
      <% if (it.pagination.prev) { %>
      <a href="/browsers?page=<%= it.pagination.prev %>" class="rounded-md border border-gray-300 px-3 py-1.5 hover:bg-gray-50">Previous</a>
      <% } else { %>
      <span class="rounded-md border border-gray-200 px-3 py-1.5 text-gray-300">Previous</span>
      <% } %>
      <% if (it.pagination.next) { %>
      <a href="/browsers?page=<%= it.pagination.next %>" class="rounded-md border border-gray-300 px-3 py-1.5 hover:bg-gray-50">Next</a>
      <% } else { %>
      <span class="rounded-md border border-gray-200 px-3 py-1.5 text-gray-300">Next</span>
      <% } %>
    </div>
  </nav>
  <% } %>
</div>
