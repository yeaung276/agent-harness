<% layout('./app') %>
<%
  const tone = percent => percent === null ? 'text-gray-300' : percent >= 90 ? 'text-red-500' : percent >= 70 ? 'text-amber-500' : 'text-green-500'
  const bar = percent => percent === null ? 'bg-gray-300' : percent >= 90 ? 'bg-red-500' : percent >= 70 ? 'bg-amber-500' : 'bg-green-500'
  const CIRCUMFERENCE = 2 * Math.PI * 40
  const m = it.machine
%>
<div class="px-8 py-6">
  <a href="/machines" class="text-sm text-gray-600 hover:text-gray-900">← Machines</a>

  <div id="stats">
    <div class="mt-2 flex items-center gap-3">
      <h1 class="font-mono text-xl font-semibold tracking-tight"><%= m.name %></h1>
      <span class="inline-flex items-center gap-1.5 text-sm capitalize">
        <span class="size-2 rounded-full <%= m.status === 'live' ? 'bg-green-500' : 'bg-amber-500' %>"></span>
        <%= m.status %>
      </span>
    </div>
    <dl class="mt-4 grid grid-cols-[max-content_1fr] gap-x-6 gap-y-1.5 text-sm">
      <dt class="text-gray-500">Address</dt>
      <dd class="font-mono"><%= m.address %></dd>
      <dt class="text-gray-500">Last report</dt>
      <dd><%= m.lastReported ?? 'Never' %></dd>
      <dt class="text-gray-500">Registered</dt>
      <dd><%= m.registered %></dd>
      <dt class="text-gray-500">Refresh</dt>
      <dd>Every 10 seconds</dd>
    </dl>

    <div class="mt-6 grid gap-4 sm:grid-cols-2">
      <% [
        { label: 'CPU', percent: m.cpu.percent, text: m.cpu.value === null ? '—' : `${m.cpu.value}%`, detail: 'of one core' },
        { label: 'Memory', percent: m.memory.percent, text: m.memory.used ?? '—', detail: m.memory.limit ? `of ${m.memory.limit}` : 'no limit' },
      ].forEach(dial => { %>
      <div class="flex items-center gap-5 rounded-lg border border-gray-200 p-5">
        <svg viewBox="0 0 100 100" class="size-24 -rotate-90" aria-hidden="true">
          <circle cx="50" cy="50" r="40" fill="none" stroke-width="10" class="stroke-gray-100"></circle>
          <circle cx="50" cy="50" r="40" fill="none" stroke-width="10" stroke-linecap="round" stroke="currentColor"
            class="<%= tone(dial.percent) %>" stroke-dasharray="<%= ((dial.percent ?? 0) / 100) * CIRCUMFERENCE %> <%= CIRCUMFERENCE %>"></circle>
        </svg>
        <div>
          <div class="text-xs uppercase tracking-wide text-gray-500"><%= dial.label %></div>
          <div class="mt-1 text-2xl font-semibold tabular-nums"><%= dial.text %></div>
          <div class="text-sm text-gray-500"><%= dial.detail %></div>
        </div>
      </div>
      <% }) %>
    </div>

    <div class="mt-4 space-y-4 rounded-lg border border-gray-200 p-5">
      <div>
        <div class="flex justify-between text-sm">
          <span class="text-gray-600">Sandboxes</span>
          <span class="tabular-nums"><%= m.sandboxes.used ?? '—' %> / <%= m.sandboxes.total ?? '—' %></span>
        </div>
        <div class="mt-1.5 h-2 rounded-full bg-gray-100">
          <div class="h-2 rounded-full <%= bar(m.sandboxes.percent) %>" style="width: <%= m.sandboxes.percent ?? 0 %>%"></div>
        </div>
      </div>
      <div class="flex justify-between text-sm">
        <span class="text-gray-600">Browser sessions</span>
        <span class="tabular-nums"><%= m.sessions ?? '—' %></span>
      </div>
    </div>
  </div>

  <section id="log-section" data-name="<%= m.name %>" class="mt-8">
    <div class="flex items-center justify-between">
      <h2 class="text-base font-semibold tracking-tight">Logs</h2>
      <span id="log-status" class="text-xs text-gray-500">Connecting…</span>
    </div>
    <div id="logs" class="mt-3 h-96 overflow-y-auto rounded-lg bg-gray-950 p-4 font-mono text-xs leading-5 text-gray-300">
      <button id="log-older" type="button" class="mb-2 text-gray-500 hover:text-gray-300" hidden>Load older</button>
      <div id="log-lines"></div>
      <p id="log-empty" class="text-gray-500" hidden>No logs yet.</p>
    </div>
  </section>
</div>
<script type="module">
  const PAGE_LINES = 100
  const LEVELS = { 10: 'trace', 20: 'debug', 30: 'info', 40: 'warn', 50: 'error', 60: 'fatal' }
  const COLORS = { 40: 'text-amber-400', 50: 'text-red-400', 60: 'text-red-400' }

  const base = `/machines/${encodeURIComponent(document.getElementById('log-section').dataset.name)}/logs`
  const box = document.getElementById('logs')
  const lines = document.getElementById('log-lines')
  const older = document.getElementById('log-older')
  const empty = document.getElementById('log-empty')
  const status = document.getElementById('log-status')
  let oldest = null
  let newest = '$'

  const render = ({ line }) => {
    const row = document.createElement('div')
    row.className = 'whitespace-pre-wrap break-all'
    row.title = line
    try {
      const entry = JSON.parse(line)
      const level = (LEVELS[entry.level] ?? String(entry.level)).toUpperCase().padEnd(5)
      const component = entry.component ? `[${entry.component}] ` : ''
      row.textContent = `${new Date(entry.time).toLocaleTimeString()} ${level} ${component}${entry.msg ?? ''}`
      if (COLORS[entry.level]) row.classList.add(COLORS[entry.level])
    } catch {
      row.textContent = line
    }
    return row
  }

  const loadOlder = async () => {
    const page = (await (await fetch(oldest ? `${base}?before=${oldest}` : base)).json()).lines
    if (oldest === null && page.length) newest = page[0].id
    if (page.length) oldest = page.at(-1).id

    const height = box.scrollHeight
    lines.prepend(...page.reverse().map(render))
    box.scrollTop += box.scrollHeight - height
    older.hidden = page.length < PAGE_LINES
    empty.hidden = lines.childElementCount > 0
  }

  older.addEventListener('click', loadOlder)
  await loadOlder()
  box.scrollTop = box.scrollHeight

  const live = new EventSource(`${base}/live?after=${encodeURIComponent(newest)}`)
  live.onopen = () => (status.textContent = 'Live')
  live.onerror = () => (status.textContent = 'Reconnecting…')
  live.onmessage = event => {
    const atBottom = box.scrollTop + box.clientHeight >= box.scrollHeight - 4
    lines.append(render(JSON.parse(event.data)))
    empty.hidden = true
    if (atBottom) box.scrollTop = box.scrollHeight
  }

  setInterval(async () => {
    const page = new DOMParser().parseFromString(await (await fetch(location.href)).text(), 'text/html')
    const stats = page.getElementById('stats')
    if (stats) document.getElementById('stats').replaceWith(stats)
  }, 10_000)
</script>
