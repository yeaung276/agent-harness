<% layout('./app') %>
<div class="px-8 py-6">
  <h1 class="text-xl font-semibold tracking-tight">Machines</h1>
  <p class="mt-1 text-sm text-gray-600">Registered workers. A worker is stale when it hasn't reported its stats in the last 30 seconds. Refreshes every 10 seconds.</p>

  <div class="mt-6 overflow-x-auto rounded-lg border border-gray-200">
    <table class="w-full text-left text-sm">
      <thead class="bg-gray-50 text-xs uppercase tracking-wide text-gray-500">
        <tr>
          <th class="px-4 py-2.5 font-medium">Status</th>
          <th class="px-4 py-2.5 font-medium">Name</th>
          <th class="px-4 py-2.5 font-medium">Address</th>
          <th class="px-4 py-2.5 font-medium">Last report</th>
          <th class="px-4 py-2.5 font-medium">Registered</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <% if (!it.machines.length) { %>
        <tr><td colspan="5" class="px-4 py-6 text-center text-gray-500">No workers have registered yet.</td></tr>
        <% } %>
        <% it.machines.forEach(machine => { %>
        <tr>
          <td class="px-4 py-2.5">
            <span class="inline-flex items-center gap-1.5 capitalize">
              <span class="size-2 rounded-full <%= machine.status === 'live' ? 'bg-green-500' : 'bg-amber-500' %>"></span>
              <%= machine.status %>
            </span>
          </td>
          <td class="px-4 py-2.5 font-mono"><a href="/machines/<%= machine.name %>" class="hover:underline"><%= machine.name %></a></td>
          <td class="px-4 py-2.5 font-mono text-gray-600"><%= machine.address %></td>
          <td class="px-4 py-2.5 text-gray-600"><%= machine.lastReported ?? 'Never' %></td>
          <td class="px-4 py-2.5 text-gray-600"><%= machine.registered %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<script>setTimeout(() => location.reload(), 10_000)</script>
