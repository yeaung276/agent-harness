<% layout('./app') %>
<div id="browser" data-id="<%= it.session.id %>" class="flex h-screen flex-col">
  <nav id="views" role="tablist" class="flex shrink-0 gap-1 border-b border-gray-200 px-4 text-sm">
    <% [['activity', 'Browser activity']].forEach(([view, label], index) => { %>
    <button type="button" role="tab" data-view="<%= view %>" aria-selected="<%= index === 0 %>" class="-mb-px border-b-2 border-transparent px-3 py-2 text-gray-500 hover:text-gray-900 aria-selected:border-gray-900 aria-selected:text-gray-900"><%= label %></button>
    <% }) %>
  </nav>
  <div data-panel="activity" class="min-h-0 flex-1 overflow-auto">
    <ul id="activities" class="divide-y divide-gray-200 text-sm"></ul>
    <p id="activities-empty" class="p-6 text-sm text-gray-500">No browser activity yet.</p>
    <nav id="activities-pages" class="flex items-center justify-between border-t border-gray-200 px-4 py-2 text-sm text-gray-500 empty:hidden"></nav>
  </div>
</div>

<template id="activity">
  <li>
    <details>
      <summary class="flex cursor-pointer items-center gap-3 px-4 py-2 hover:bg-gray-50">
        <span data-kind class="w-12 shrink-0 text-xs uppercase text-gray-500"></span>
        <code data-command class="min-w-0 flex-1 truncate font-mono text-xs"></code>
        <span data-status class="shrink-0 rounded px-2 py-0.5 text-xs"></span>
        <time data-time class="shrink-0 text-xs text-gray-500"></time>
      </summary>
      <pre data-output class="mx-4 mb-3 max-h-80 overflow-auto rounded border border-gray-200 bg-gray-50 p-3 font-mono text-xs leading-5 whitespace-pre-wrap"></pre>
    </details>
  </li>
</template>
<template id="activity-pages">
  <div class="contents">
    <span data-range></span>
    <div class="flex gap-2">
      <button type="button" data-prev class="rounded border border-gray-200 px-2 py-1 hover:bg-gray-50 disabled:opacity-50">Previous</button>
      <button type="button" data-next class="rounded border border-gray-200 px-2 py-1 hover:bg-gray-50 disabled:opacity-50">Next</button>
    </div>
  </div>
</template>

<script>
  const base = `/browsers/${document.getElementById('browser').dataset.id}`

  const clone = id => document.getElementById(id).content.firstElementChild.cloneNode(true)

  const activityList = document.getElementById('activities')
  const activityEmpty = document.getElementById('activities-empty')
  const activityPages = document.getElementById('activities-pages')
  const statusColors = {
    succeeded: 'bg-green-50 text-green-700',
    failed: 'bg-red-50 text-red-700',
  }

  const showActivities = async page => {
    const res = await fetch(`${base}/activities?page=${page}`)
    if (!res.ok) return
    const { items, pagination } = await res.json()

    activityList.replaceChildren(
      ...items.map(item => {
        const row = clone('activity')
        row.querySelector('[data-kind]').textContent = item.kind
        row.querySelector('[data-command]').textContent = item.command
        const status = row.querySelector('[data-status]')
        status.textContent = item.status
        status.classList.add(...statusColors[item.status].split(' '))
        row.querySelector('[data-time]').textContent = new Date(item.createdAt).toLocaleString()
        row.querySelector('[data-output]').textContent = item.output || 'No output'
        return row
      })
    )
    activityEmpty.hidden = items.length > 0

    activityPages.replaceChildren()
    if (pagination.prev === null && pagination.next === null) return
    const pages = clone('activity-pages')
    pages.querySelector('[data-range]').textContent = `${pagination.from}–${pagination.to} of ${pagination.total}`
    for (const [key, target] of [['prev', pagination.prev], ['next', pagination.next]]) {
      const button = pages.querySelector(`[data-${key}]`)
      button.disabled = target === null
      button.addEventListener('click', () => showActivities(target))
    }
    activityPages.append(pages)
  }

  showActivities(1)
</script>
