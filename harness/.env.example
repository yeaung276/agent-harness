NODE_ENV=development
LOG_LEVEL=info
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app
REDIS_URL=redis://localhost:6379
WORKSPACES_DIR=../workspaces
DATA_ENCRYPTION_KEY=

SANDBOX_MODE=none
SANDBOX_DEPS_ROOT=/tmp/workspace-deps
SANDBOX_IDLE_MS=900000
SANDBOX_MEMORY_MAX_MB=2048
SANDBOX_CPU_MAX=2
SANDBOX_PIDS_MAX=512

WORKSPACE_PORT_MIN=4100
WORKSPACE_PORT_MAX=4149
WORKSPACE_INSTALL_TIMEOUT_MS=600000
WORKSPACE_READY_TIMEOUT_MS=90000
WORKSPACE_EXEC_TIMEOUT_MS=120000
WORKSPACE_EXEC_MAX_TIMEOUT_MS=240000
