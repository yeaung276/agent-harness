{
  "name": "@code-harness/sdk",
  "version": "0.1.0",
  "description": "TypeScript client for Code-Harness sandboxes and browsers, with a deepagents backend and LangChain middleware",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yeaung276/agent-harness.git",
    "directory": "sdk/js"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "bun test"
  },
  "peerDependencies": {
    "@langchain/core": "^1.3.2",
    "deepagents": "^1.16.0",
    "langchain": "^1.6.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@langchain/core": "^1.3.4",
    "@types/bun": "^1.4.3",
    "@types/node": "^20.19.0",
    "deepagents": "^1.16.2",
    "langchain": "^1.6.1",
    "typescript": "^7.0.2",
    "zod": "^4.3.6"
  }
}
