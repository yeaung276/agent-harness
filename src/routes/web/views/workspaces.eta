<% layout('./app') %>
<div class="px-8 py-6">
  <div class="flex items-start justify-between gap-4">
    <div>
      <h1 class="text-xl font-semibold tracking-tight">Workspaces</h1>
      <p class="mt-1 text-sm text-gray-600">Everyone sees every workspace.</p>
    </div>
    <button type="button" onclick="document.getElementById('create-workspace').showModal()" class="rounded-md bg-gray-900 px-3 py-2 text-sm font-medium text-white hover:bg-gray-700">Create workspace</button>
  </div>

  <dialog id="create-workspace" class="m-auto w-full max-w-lg rounded-lg border border-gray-200 p-6 shadow-lg backdrop:bg-black/30">
    <h2 class="text-base font-semibold">Create workspace</h2>
    <form method="post" action="/workspaces" enctype="multipart/form-data" class="mt-4">
      <label class="block">
        <span class="text-sm font-medium">Name</span>
        <input name="name" required maxlength="63" value="<%= it.form?.name ?? '' %>" placeholder="my-app" autofocus class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm">
      </label>
      <% if (it.form?.error) { %>
      <p class="mt-2 text-sm text-red-600"><%= it.form.error %></p>
      <% } else { %>
      <p class="mt-2 text-sm text-gray-500">Lowercase letters, digits and -, up to 63.</p>
      <% } %>
      <label class="mt-4 block">
        <span class="text-sm font-medium">Zip <span class="font-normal text-gray-500">(optional)</span></span>
        <input type="file" name="file" accept=".zip" class="mt-1 block w-full text-sm">
      </label>
      <%~ include('./env-picker') %>
      <div class="mt-6 flex justify-end gap-2">
        <button type="submit" formmethod="dialog" formnovalidate class="rounded-md border border-gray-300 px-3 py-2 text-sm font-medium hover:bg-gray-50">Cancel</button>
        <button type="submit" class="rounded-md bg-gray-900 px-3 py-2 text-sm font-medium text-white hover:bg-gray-700">Create</button>
      </div>
    </form>
  </dialog>
  <% if (it.form) { /* a refused name comes back with the modal open */ %>
  <script>document.getElementById('create-workspace').showModal()</script>
  <% } %>

  <dialog id="edit-workspace" class="m-auto w-full max-w-lg rounded-lg border border-gray-200 p-6 shadow-lg backdrop:bg-black/30">
    <h2 class="text-base font-semibold">Edit <span data-workspace></span></h2>
    <p class="mt-1 text-sm text-gray-500">Values are encrypted and not shown. To change one, remove it and add it again.</p>
    <form method="post">
      <%~ include('./env-picker') %>
      <div class="mt-6 flex justify-end gap-2">
        <button type="submit" formmethod="dialog" formnovalidate class="rounded-md border border-gray-300 px-3 py-2 text-sm font-medium hover:bg-gray-50">Cancel</button>
        <button type="submit" class="rounded-md bg-gray-900 px-3 py-2 text-sm font-medium text-white hover:bg-gray-700">Save</button>
      </div>
    </form>
  </dialog>
  <script>
    document.addEventListener('click', event => {
      const button = event.target.closest('[data-edit]')
      if (!button) return
      const dialog = document.getElementById('edit-workspace')
      dialog.querySelector('form').action = `/workspaces/${button.dataset.edit}/env`
      dialog.querySelector('[data-workspace]').textContent = button.dataset.name
      const template = dialog.querySelector('template[data-existing]')
      dialog.querySelector('[data-rows]').replaceChildren(
        ...JSON.parse(button.dataset.keys).map(key => {
          const row = template.content.firstElementChild.cloneNode(true)
          row.querySelector('[data-key]').value = key
          return row
        })
      )
      dialog.showModal()
    })
  </script>

  <div class="mt-6 overflow-x-auto rounded-lg border border-gray-200">
    <table class="w-full text-left text-sm">
      <thead class="bg-gray-50 text-xs uppercase tracking-wide text-gray-500">
        <tr>
          <th class="px-4 py-2.5 font-medium">Name</th>
          <th class="px-4 py-2.5 font-medium">Status</th>
          <th class="px-4 py-2.5 font-medium">Created</th>
          <th class="px-4 py-2.5 font-medium">Created by</th>
          <th class="px-4 py-2.5"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <% if (!it.workspaces.length) { %>
        <tr><td colspan="5"class="px-4 py-6 text-center text-gray-500"><%= it.pagination.total ? 'No workspaces on this page.' : 'No workspaces yet.' %></td></tr>
        <% } %>
        <% it.workspaces.forEach(workspace => { %>
        <tr>
          <td class="px-4 py-2.5 font-medium"><%= workspace.name %></td>
          <td class="px-4 py-2.5">
            <span class="inline-flex items-center gap-1.5 capitalize">
              <span class="size-2 rounded-full <%= workspace.status === 'running' ? 'bg-green-500' : 'bg-gray-400' %>"></span>
              <%= workspace.status %>
            </span>
          </td>
          <td class="px-4 py-2.5 text-gray-600"><%= workspace.created %></td>
          <td class="px-4 py-2.5 text-gray-600"><%= workspace.createdBy %></td>
          <td class="px-4 py-2.5 text-right">
            <a href="/workspaces/<%= workspace.id %>" class="mr-3 text-sm text-gray-600 hover:text-gray-900">View</a>
            <button type="button" data-edit="<%= workspace.id %>" data-name="<%= workspace.name %>" data-keys="<%= JSON.stringify(workspace.defaultEnvKeys) %>" class="mr-3 text-sm text-gray-600 hover:text-gray-900">Edit</button>
            <form method="post" action="/workspaces/<%= workspace.id %>/delete" onsubmit="return confirm('Delete this workspace and all its files?')" class="inline">
              <button type="submit" class="text-sm text-red-600 hover:text-red-800">Delete</button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <% if (it.pagination.total) { %>
  <nav class="mt-3 flex items-center justify-between text-sm text-gray-600" aria-label="Pagination">
    <span><%= it.workspaces.length ? `${it.pagination.from}–${it.pagination.to} of ${it.pagination.total}` : `${it.pagination.total} in all` %></span>
    <div class="flex gap-2">
      <% if (it.pagination.prev) { %>
      <a href="/workspaces?page=<%= it.pagination.prev %>" class="rounded-md border border-gray-300 px-3 py-1.5 hover:bg-gray-50">Previous</a>
      <% } else { %>
      <span class="rounded-md border border-gray-200 px-3 py-1.5 text-gray-300">Previous</span>
      <% } %>
      <% if (it.pagination.next) { %>
      <a href="/workspaces?page=<%= it.pagination.next %>" class="rounded-md border border-gray-300 px-3 py-1.5 hover:bg-gray-50">Next</a>
      <% } else { %>
      <span class="rounded-md border border-gray-200 px-3 py-1.5 text-gray-300">Next</span>
      <% } %>
    </div>
  </nav>
  <% } %>
</div>
